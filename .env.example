# GEMINI_API_KEY: Required for Gemini AI API calls (tools 02-05).
# Get a key from https://aistudio.google.com/app/apikey
# Locally: copy this file to .env.local and paste your key below.
# In production (Hostinger / Cloud Run): set this as an environment variable.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# GEMINI_MODEL (optional): override the AI model. Defaults to gemini-2.5-flash.
# GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The public URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://laodocs.com"
