{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile metadata including subscription status",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID matching request.auth.uid" },
        "email": { "type": "string", "description": "Email address of the user" },
        "displayName": { "type": "string", "description": "Display name" },
        "subscriptionTier": { "type": "string", "enum": ["free", "pro", "ultra"], "description": "Subscription tier of the user" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["userId", "email", "subscriptionTier", "createdAt"]
    },
    "Document": {
      "title": "Document",
      "description": "Laos formal documents, including sender, receiver, original text, and converted text",
      "type": "object",
      "properties": {
        "documentId": { "type": "string", "description": "ID of the document" },
        "ownerId": { "type": "string", "description": "The user UID that owns the document" },
        "title": { "type": "string", "description": "Title or subject of the formal letter" },
        "sender": { "type": "string", "description": "Sender organization or person" },
        "receiver": { "type": "string", "description": "Receiver organization or person" },
        "sourceType": { "type": "string", "description": "Source of conversion: text, image, or pdf" },
        "originalText": { "type": "string", "description": "Original text before clean up or font conversion" },
        "convertedText": { "type": "string", "description": "Cleaned up text with Phetsarath OT and Times New Roman fonts applied" },
        "status": { "type": "string", "enum": ["draft", "saved", "final"], "description": "Tracking status of the document" },
        "flowStatus": { "type": "string", "description": "Document tracking stage, e.g. Sent, Received, Processing, Filed" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["documentId", "ownerId", "title", "status", "createdAt", "updatedAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Support chat lobby for user and admin",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "description": "Chat ID (matches user UID)" },
        "userId": { "type": "string", "description": "User UID" },
        "userEmail": { "type": "string", "description": "User email address" },
        "userName": { "type": "string", "description": "User display name" },
        "lastMessage": { "type": "string", "description": "Content of last message in chat" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last updated timestamp" },
        "unreadByAdmin": { "type": "boolean", "description": "Whether there are unread messages for admin" },
        "unreadByUser": { "type": "boolean", "description": "Whether there are unread messages for user" }
      },
      "required": ["chatId", "userId", "userEmail", "userName", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message in a support chat",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "description": "Message document ID" },
        "senderId": { "type": "string", "description": "UID of the message sender" },
        "senderName": { "type": "string", "description": "Display name of the sender" },
        "text": { "type": "string", "description": "Message body" },
        "screenshot": { "type": "string", "description": "Optional compressed screenshot base64 image data" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when sent" }
      },
      "required": ["messageId", "senderId", "senderName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/documents/{documentId}": {
      "schema": "Document",
      "description": "Formal documents and letters"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat details between user and admin"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside a support chat"
    }
  }
}
